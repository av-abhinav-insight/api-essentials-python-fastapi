{
  "info": {
    "name": "Banking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Get Account Balance",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/accounts/acc-1001/balance",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "acc-1001", "balance"]
        }
      }
    }
  ]
}
