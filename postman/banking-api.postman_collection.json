{
  "info": {
    "name": "Banking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Login - Asha",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('access_token', body.access_token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"asha\",\n  \"password\": \"anything\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Login - Unknown User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"nobody\",\n  \"password\": \"anything\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Get Account Balance",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/accounts/acc-1001/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "acc-1001",
            "balance"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ]
      }
    },
    {
      "name": "Get Account Balance - No Token",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/accounts/acc-1001/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "acc-1001",
            "balance"
          ]
        }
      }
    },
    {
      "name": "Create Transfer - Valid",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_account\": \"acc-1001\",\n  \"to_account\": \"acc-1002\",\n  \"amount\": 500\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transfers"
          ]
        }
      }
    },
    {
      "name": "Create Transfer - Malformed Body",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_account\": \"acc-1001\",\n  \"amount\": \"not-a-number\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transfers"
          ]
        }
      }
    },
    {
      "name": "Transfer - Negative Amount",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_account\": \"acc-1001\",\n  \"to_account\": \"acc-1002\",\n  \"amount\": -500\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transfers"
          ]
        }
      }
    },
    {
      "name": "Transfer - Zero Amount",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_account\": \"acc-1001\",\n  \"to_account\": \"acc-1002\",\n  \"amount\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transfers"
          ]
        }
      }
    },
    {
      "name": "Transfer - Missing Field",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_account\": \"acc-1001\",\n  \"amount\": 500\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transfers"
          ]
        }
      }
    },
    {
      "name": "Transfer - Same Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_account\": \"acc-1001\",\n  \"to_account\": \"acc-1001\",\n  \"amount\": 500\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transfers"
          ]
        }
      }
    },
    {
      "name": "Transfer - Bad Account Format",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_account\": \"1001\",\n  \"to_account\": \"acc-1002\",\n  \"amount\": 500\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transfers"
          ]
        }
      }
    },
    {
      "name": "Transfer - Blocked Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_account\": \"acc-1003\",\n  \"to_account\": \"acc-1001\",\n  \"amount\": 500\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transfers"
          ]
        }
      }
    },
    {
      "name": "Transfer - Over Daily Limit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_account\": \"acc-1001\",\n  \"to_account\": \"acc-1002\",\n  \"amount\": 60000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transfers"
          ]
        }
      }
    },
    {
      "name": "Transfer - Insufficient Balance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_account\": \"acc-1002\",\n  \"to_account\": \"acc-1001\",\n  \"amount\": 20000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transfers"
          ]
        }
      }
    }
  ]
}
